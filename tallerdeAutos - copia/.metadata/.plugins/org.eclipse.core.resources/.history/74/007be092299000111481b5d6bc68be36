/* ---------- Modales / formularios ---------- */
.modal-overlay{
  position:fixed; inset:0; background:rgba(10,10,10,.6); backdrop-filter:blur(2px);
  display:none; align-items:flex-start; justify-content:center; z-index:200;
  padding:40px 16px; overflow-y:auto;
}
.modal-overlay.open{ display:flex; }
.modal{
  background:var(--panel); border:1px solid var(--border); border-radius:var(--radius);
  width:100%; max-width:560px; box-shadow:var(--shadow); padding:22px 24px 24px;
}
.modal.wide{ max-width:760px; }
.modal-head{ display:flex; align-items:center; justify-content:space-between; margin-bottom:16px; }
.modal-head h3{ font-size:16px; margin:0; color:var(--text); }
.modal-close{ font-size:20px; color:var(--text-faint); line-height:1; padding:2px 6px; border-radius:4px; }
.modal-close:hover{ color:var(--text); background:var(--panel-alt); }

.form-grid{ display:grid; grid-template-columns:1fr 1fr; gap:12px 14px; }
.form-grid.single{ grid-template-columns:1fr; }
.field{ display:flex; flex-direction:column; gap:5px; }
.field.span-2{ grid-column:1 / -1; }
.field label{ font-size:11.5px; color:var(--text-muted); text-transform:uppercase; letter-spacing:.05em; }
.field input, .field select, .field textarea{
  background:var(--panel-alt); border:1px solid var(--border); border-radius:4px;
  color:var(--text); font-size:13.5px; padding:8px 10px; font-family:inherit;
}
.field input:focus, .field select:focus, .field textarea:focus{ border-color:var(--amber); }
.field small{ color:var(--text-faint); font-size:11px; }

.alert-box{
  display:none; align-items:flex-start; gap:9px; padding:10px 12px; border-radius:4px;
  font-size:12.5px; line-height:1.4; margin-bottom:4px;
}
.alert-box.show{ display:flex; }
.alert-box.info{ background:rgba(232,163,61,.1); border:1px solid rgba(232,163,61,.35); color:var(--amber); }
.alert-box.error{ background:rgba(192,82,79,.1); border:1px solid rgba(192,82,79,.35); color:var(--st-rechazado); }
.alert-box.ok{ background:rgba(79,160,122,.1); border:1px solid rgba(79,160,122,.35); color:var(--st-terminado); }

.modal-actions{ display:flex; justify-content:flex-end; gap:10px; margin-top:18px; }
.section-divider{ border-top:1px dashed var(--border); margin:16px 0; padding-top:14px; }
.section-divider h4{ font-size:11.5px; text-transform:uppercase; letter-spacing:.07em; color:var(--text-faint); margin:0 0 10px; }

.line-item-row{ display:grid; grid-template-columns:2fr 1fr 1fr auto; gap:8px; align-items:end; margin-bottom:8px; }
.line-item-list{ display:flex; flex-direction:column; gap:0; margin-bottom:8px; }
.line-item-chip{
  display:flex; justify-content:space-between; align-items:center; font-size:12.5px;
  padding:7px 10px; background:var(--panel-alt); border:1px solid var(--border); border-radius:4px; margin-bottom:6px;
}
.line-item-chip button{ color:var(--st-rechazado); font-size:15px; }
.btn.small{ padding:5px 10px; font-size:11.5px; }
.btn:disabled{ opacity:.5; cursor:not-allowed; }
.toast-stack{ position:fixed; top:18px; right:18px; z-index:300; display:flex; flex-direction:column; gap:8px; }
.toast{
  background:var(--panel-raised); border:1px solid var(--border); border-left:3px solid var(--st-terminado);
  padding:10px 14px; border-radius:4px; font-size:12.5px; color:var(--text); box-shadow:var(--shadow); max-width:320px;
}
.toast.error{ border-left-color:var(--st-rechazado); }