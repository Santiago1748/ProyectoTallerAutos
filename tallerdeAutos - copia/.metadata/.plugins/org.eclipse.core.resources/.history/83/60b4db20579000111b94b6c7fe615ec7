package servlet;

import java.io.IOException;
import javax.servlet.ServletException;
import javax.servlet.annotation.WebServlet;
import javax.servlet.http.HttpServlet;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;

import DAO.DAOFactory;
import entidad.Usuario;
import interfaces.LoginUsuarioDAO;
import util.Constantes;
import util.SessionProject;

/**
 * Servlet implementation class LoginServlet
 */
@WebServlet("/LoginServlet")
public class LoginServlet extends HttpServlet {
	private static final long serialVersionUID = 1L;
       
    /**
     * @see HttpServlet#HttpServlet()
     */
    public LoginServlet() {
        super();
        // TODO Auto-generated constructor stub
    }

	/**
	 * @see HttpServlet#service(HttpServletRequest request, HttpServletResponse response)
	 */
	protected void service(HttpServletRequest request, HttpServletResponse response) throws ServletException, IOException {
		
		String opcion = request.getParameter("opc");
		if (opcion.equals("login")) {
			 String user = request.getParameter("txtUsuario");
			 String password = request.getParameter("txtPassword");
			 
			DAOFactory daoFactory = DAOFactory.getDAOFactory(DAOFactory.MYSQL);
			LoginUsuarioDAO  dao = daoFactory.getLoginUsuarioDAO();
			Usuario usu = dao.validarLogin(user, password);
			

		if(usu != null) {
				SessionProject sessionProject= new SessionProject();
				sessionProject.saveSessionTimeOut(request, 30);
				sessionProject.saveSessionString(request, Constantes.NAME, usu.getApellidos());
				sessionProject.saveSessionString(request, Constantes.LASTNAME, usu.getNombres());
				sessionProject.saveSessionString(request, Constantes.USER, usu.getUsuario());
				sessionProject.saveSessionString(request, Constantes.PASSWORD, usu.getPassword());
				
				response.sendRedirect("index.jsp");
				
			}else {
				request.setAttribute("mensaje", "usuario y/o contraseña es incorrescto");
				request.getRequestDispatcher("login.jsp").forward(request, response);
				
				
			}
		}else if (opcion.equals("logout")) {
			
			SessionProject session = new SessionProject();
			session.invalidateSession(request);
			response.sendRedirect("index.jsp");
		}
	}


}
