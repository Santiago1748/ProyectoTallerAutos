package entidad;

import java.time.LocalDate;
import java.time.LocalDateTime;

public class Usuario {
	
	public int id;
	public String codigo;
	public String usuario;
	public String password;
	public LocalDateTime fec_ultimases;
	public int id_rol;
	public LocalDateTime fec_crea;
	public LocalDateTime fec_modif;
	public boolean empleado;
	public String apellidos;
	public String nombres;
	public LocalDate fecha_nac;
	public String celular;
	public String correo;
	public double salario;
	public boolean estado;
	
	
	
	public Usuario() {
		
	}



	public Usuario(int id, String codigo, String usuario, String password, LocalDateTime fec_ultimases, int id_rol,
			LocalDateTime fec_crea, LocalDateTime fec_modif, boolean empleado, String apellidos, String nombres,
			LocalDate fecha_nac, String celular, String correo, double salario, boolean estado) {
		super();
		this.id = id;
		this.codigo = codigo;
		this.usuario = usuario;
		this.password = password;
		this.fec_ultimases = fec_ultimases;
		this.id_rol = id_rol;
		this.fec_crea = fec_crea;
		this.fec_modif = fec_modif;
		this.empleado = empleado;
		this.apellidos = apellidos;
		this.nombres = nombres;
		this.fecha_nac = fecha_nac;
		this.celular = celular;
		this.correo = correo;
		this.salario = salario;
		this.estado = estado;
	}



	public int getId() {
		return id;
	}



	public void setId(int id) {
		this.id = id;
	}



	public String getCodigo() {
		return codigo;
	}



	public void setCodigo(String codigo) {
		this.codigo = codigo;
	}



	public String getUsuario() {
		return usuario;
	}



	public void setUsuario(String usuario) {
		this.usuario = usuario;
	}



	public String getPassword() {
		return password;
	}



	public void setPassword(String password) {
		this.password = password;
	}



	public LocalDateTime getFec_ultimases() {
		return fec_ultimases;
	}



	public void setFec_ultimases(LocalDateTime fec_ultimases) {
		this.fec_ultimases = fec_ultimases;
	}



	public int getId_rol() {
		return id_rol;
	}



	public void setId_rol(int id_rol) {
		this.id_rol = id_rol;
	}



	public LocalDateTime getFec_crea() {
		return fec_crea;
	}



	public void setFec_crea(LocalDateTime fec_crea) {
		this.fec_crea = fec_crea;
	}



	public LocalDateTime getFec_modif() {
		return fec_modif;
	}



	public void setFec_modif(LocalDateTime fec_modif) {
		this.fec_modif = fec_modif;
	}



	public boolean isEmpleado() {
		return empleado;
	}



	public void setEmpleado(boolean empleado) {
		this.empleado = empleado;
	}



	public String getApellidos() {
		return apellidos;
	}



	public void setApellidos(String apellidos) {
		this.apellidos = apellidos;
	}



	public String getNombres() {
		return nombres;
	}



	public void setNombres(String nombres) {
		this.nombres = nombres;
	}



	public LocalDate getFecha_nac() {
		return fecha_nac;
	}



	public void setFecha_nac(LocalDate fecha_nac) {
		this.fecha_nac = fecha_nac;
	}



	public String getCelular() {
		return celular;
	}



	public void setCelular(String celular) {
		this.celular = celular;
	}



	public String getCorreo() {
		return correo;
	}



	public void setCorreo(String correo) {
		this.correo = correo;
	}



	public double getSalario() {
		return salario;
	}



	public void setSalario(double salario) {
		this.salario = salario;
	}



	public boolean isEstado() {
		return estado;
	}



	public void setEstado(boolean estado) {
		this.estado = estado;
	}
	
	
	

}
