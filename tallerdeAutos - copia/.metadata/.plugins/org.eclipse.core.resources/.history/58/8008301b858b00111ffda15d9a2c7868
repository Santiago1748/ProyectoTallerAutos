/* ============================================================
   ESTADO GLOBAL Y ADAPTACIÓN DE API A SERVLET JAVA (/api)
   ============================================================ */
const CATALOGOS = { tipo_documento:[], marca_vehiculo:[], marca_producto:[], categoria_producto:[], forma_pago:[], rol:[], almacenes:[] };
let SECCION_ACTUAL = 'dashboard';
let ORDEN_ACTUAL = null;

async function api(action, { method = 'GET', params = null, body = null } = {}) {
  let url = `api?action=${action}`;
  if (params) url += '&' + new URLSearchParams(params).toString();
  const opts = { method };
  if (body) { opts.headers = { 'Content-Type': 'application/json' }; opts.body = JSON.stringify(body); }
  const res = await fetch(url, opts);
  const json = await res.json();
  if (!json.ok) throw new Error(json.error || 'Error desconocido');
  return json.data;
}

function toast(msg, tipo = 'ok') {
  const t = document.createElement('div');
  t.className = `toast ${tipo}`;
  t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(() => t.remove(), 3800);
}
function fmt(n){ return 'S/ ' + Number(n ?? 0).toFixed(2); }
function fmtDate(s){ if(!s) return '—'; return String(s).replace('T',' ').slice(0,16); }
function esc(s){ return (s ?? '').toString().replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
function badgeEstado(estado){
  const clave = (estado||'').toLowerCase().replace(/ /g,'_');
  return `<span class="badge ${clave}">${esc(estado||'—')}</span>`;
}

