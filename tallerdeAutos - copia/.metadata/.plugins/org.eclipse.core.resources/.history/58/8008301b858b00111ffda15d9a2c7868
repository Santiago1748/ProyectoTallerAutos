function renderNav(){
  document.getElementById('nav').innerHTML = SECCIONES.map(s =>
    `<button class="nav-item ${s.id===SECCION_ACTUAL?'active':''}" data-seccion="${s.id}">
       <span>${s.icon}</span> ${s.label}
     </button>`).join('');
  document.querySelectorAll('.nav-item').forEach(el => el.addEventListener('click', () => ir(el.dataset.seccion)));
}

async function ir(seccion){
  SECCION_ACTUAL = seccion;
  renderNav();
  const main = document.getElementById('main');
  main.innerHTML = '<div class="empty">Cargando…</div>';
  try {
    const renderers = {
      dashboard: renderDashboard, nueva_orden: renderNuevaOrden, ordenes: renderOrdenes,
      clientes: renderClientes, vehiculos: renderVehiculos, productos: renderProductos,
      compras: renderCompras, usuarios: renderUsuarios, reportes: renderReportes,
    };
    await renderers[seccion](main);
  } catch (e) {
    main.innerHTML = `<div class="card">Error al cargar: ${esc(e.message)}</div>`;
  }
}

