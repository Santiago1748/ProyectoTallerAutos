function selectConAlta(id, catalogo, opciones, extraAttr = '', placeholder = 'Seleccionar…'){
  const opts = opciones.map(o => `<option value="${o.id}">${esc(o.nombre)}</option>`).join('');
  return `<div class="select-with-add">
      <select id="${id}" ${extraAttr}><option value="">${placeholder}</option>${opts}</select>
      <button type="button" class="btn btn-sm btn-icon" title="Crear nuevo" onclick="altaCatalogo('${catalogo}','${id}')">＋</button>
    </div>`;
}

async function altaCatalogo(catalogo, selectId, extra = {}){
  const nombre = prompt('Nombre del nuevo registro:');
  if (!nombre) return;
  try {
    let data;
    if (catalogo === 'modelo_vehiculo') {
      const idMarca = document.getElementById(extra.marcaSelectId).value;
      if (!idMarca) { toast('Primero selecciona la marca.', 'error'); return; }
      data = await api('crear_modelo_vehiculo', { method:'POST', body:{ id_marca:idMarca, nombre } });
    } else {
      const accion = { marca_vehiculo:'crear_marca_vehiculo', marca_producto:'crear_marca_producto', categoria_producto:'crear_categoria_producto' }[catalogo];
      data = await api(accion, { method:'POST', body:{ nombre } });
    }
    const sel = document.getElementById(selectId);
    const opt = document.createElement('option');
    opt.value = data.id; opt.textContent = data.nombre; opt.selected = true;
    sel.appendChild(opt);
    toast('Registro creado y seleccionado.');
  } catch (e) { toast(e.message, 'error'); }
}

async function cargarModelos(idMarca, selectModeloId){
  const sel = document.getElementById(selectModeloId);
  sel.innerHTML = '<option value="">Cargando…</option>';
  if (!idMarca) { sel.innerHTML = '<option value="">Seleccionar…</option>'; return; }
  const modelos = await api('listar_modelos_vehiculo', { params:{ id_marca:idMarca } });
  sel.innerHTML = '<option value="">Seleccionar…</option>' + modelos.map(m => `<option value="${m.id}">${esc(m.nombre)}</option>`).join('');
}

function cerrarModal(){ document.querySelector('.modal-bg')?.remove(); }
function abrirModal(html){
  cerrarModal();
  const bg = document.createElement('div');
  bg.className = 'modal-bg';
  bg.innerHTML = `<div class="modal">${html}</div>`;
  bg.addEventListener('click', e => { if (e.target === bg) cerrarModal(); });
  document.body.appendChild(bg);
}

function tablaHtml(columnas, filas, onRowClick){
  if (!filas.length) return '<div class="empty">No hay registros.</div>';
  const head = columnas.map(c => `<th>${c.label}</th>`).join('');
  const body = filas.map((f, i) => `<tr data-idx="${i}">${columnas.map(c => `<td>${c.render ? c.render(f) : esc(f[c.key])}</td>`).join('')}</tr>`).join('');
  const id = 'tbl_' + Math.random().toString(36).slice(2, 8);
  setTimeout(() => {
    if (!onRowClick) return;
    document.getElementById(id)?.querySelectorAll('tbody tr').forEach(tr => tr.addEventListener('click', () => onRowClick(filas[tr.dataset.idx])));
  }, 0);
  return `<div class="table-wrap"><table id="${id}"><thead><tr>${head}</tr></thead><tbody>${body}</tbody></table></div>`;
}

async function precargarCatalogos(){
  try {
    const [td, mv, mp, cp, fp, roles, almacenes] = await Promise.all([
      api('listar_catalogo', { params:{ tabla:'tipo_documento' } }),
      api('listar_catalogo', { params:{ tabla:'marca_vehiculo' } }),
      api('listar_catalogo', { params:{ tabla:'marca_producto' } }),
      api('listar_catalogo', { params:{ tabla:'categoria_producto' } }),
      api('listar_catalogo', { params:{ tabla:'forma_pago' } }),
      api('listar_catalogo', { params:{ tabla:'rol' } }),
      api('listar_almacenes', {}),
    ]);
    Object.assign(CATALOGOS, { tipo_documento:td, marca_vehiculo:mv, marca_producto:mp, categoria_producto:cp, forma_pago:fp, rol:roles, almacenes });
  } catch(e) {}
}

