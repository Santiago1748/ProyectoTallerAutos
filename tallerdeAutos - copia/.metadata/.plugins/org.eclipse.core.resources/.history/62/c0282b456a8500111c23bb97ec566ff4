<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Taller Fortuna — Ingresar</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#1b1d1f;
    --panel:#232628;
    --panel-alt:#2a2d30;
    --panel-raised:#2f3235;
    --border:#3a3e42;
    --text:#ece8e0;
    --text-muted:#9a9691;
    --text-faint:#6c6864;
    --amber:#e8a33d;
    --st-terminado:#4fa07a;
    --st-rechazado:#c0524f;
    --radius:6px;
    --shadow: 0 8px 24px rgba(0,0,0,.35);
  }
  *{ box-sizing:border-box; }
  html,body{ margin:0; padding:0; height:100%; }
  body{
    background:
      radial-gradient(ellipse at top left, rgba(232,163,61,.06), transparent 45%),
      var(--bg);
    color:var(--text);
    font-family:'IBM Plex Sans', sans-serif;
    -webkit-font-smoothing:antialiased;
    min-height:100vh;
  }
  h1,.display{ font-family:'Oswald', sans-serif; text-transform:uppercase; letter-spacing:.03em; }
  a, button{ font-family:inherit; }
  button{ cursor:pointer; }
  :focus-visible{ outline:2px solid var(--amber); outline-offset:2px; }

  .hazard-bar{
    height:6px;
    background:repeating-linear-gradient(-45deg, var(--amber) 0 10px, #1b1d1f 10px 20px);
    opacity:.55;
  }

  .login-wrap{
    min-height:calc(100vh - 6px);
    display:flex;
    align-items:center;
    justify-content:center;
    padding:32px 16px;
  }

  .login-card{
    width:100%;
    max-width:380px;
    background:var(--panel);
    border:1px solid var(--border);
    border-radius:var(--radius);
    padding:32px 30px 26px;
    box-shadow:var(--shadow);
  }

  .brand{ display:flex; align-items:center; gap:11px; margin-bottom:26px; }
  .brand-mark{
    width:36px; height:36px; border-radius:4px; flex-shrink:0;
    background:repeating-linear-gradient(45deg, var(--amber) 0 6px, #1b1d1f 6px 12px);
    box-shadow: inset 0 0 0 2px #18191b, 0 0 0 1px var(--border);
  }
  .brand-text .display{ font-size:16px; margin:0; line-height:1.1; color:var(--text); }
  .brand-text span{ font-size:10.5px; color:var(--text-faint); letter-spacing:.08em; text-transform:uppercase; }

  h1{ font-size:21px; margin:0 0 4px; color:var(--text); }
  .sub{ font-size:13px; color:var(--text-muted); margin:0 0 22px; }

  .alert-error{
    display:flex; align-items:flex-start; gap:9px;
    background:rgba(192,82,79,.1);
    border:1px solid rgba(192,82,79,.35);
    color:#e0a6a4;
    border-radius:var(--radius);
    padding:10px 12px;
    font-size:12.5px;
    margin-bottom:18px;
  }
  .alert-error svg{ width:17px; height:17px; flex-shrink:0; margin-top:1px; color:var(--st-rechazado); }

  .field{ display:block; margin-bottom:16px; }
  .field-label{
    display:block; font-size:11.5px; color:var(--text-muted);
    text-transform:uppercase; letter-spacing:.06em; margin-bottom:6px;
  }
  .field input{
    width:100%;
    background:var(--panel-alt);
    border:1px solid var(--border);
    border-radius:var(--radius);
    padding:11px 12px;
    font-size:14px;
    color:var(--text);
    transition:border-color .12s;
  }
  .field input::placeholder{ color:var(--text-faint); }
  .field input:focus{ border-color:var(--amber); }
  .field input.input-error{ border-color:var(--st-rechazado); }

  .password-box{ position:relative; }
  .password-box input{ padding-right:42px; }
  .toggle-btn{
    position:absolute; right:6px; top:50%; transform:translateY(-50%);
    background:none; border:none; color:var(--text-faint);
    width:30px; height:30px; display:flex; align-items:center; justify-content:center;
    border-radius:4px;
  }
  .toggle-btn:hover{ color:var(--amber); background:var(--panel-raised); }
  .toggle-btn svg{ width:18px; height:18px; }

  .field-error{ font-size:12px; color:var(--st-rechazado); margin:-8px 0 14px; min-height:14px; }

  .btn-submit{
    width:100%;
    padding:12px;
    border-radius:var(--radius);
    border:1px solid var(--amber);
    background:var(--amber);
    color:#1b1d1f;
    font-size:14px;
    font-weight:600;
    margin-top:4px;
    transition:background .12s;
  }
  .btn-submit:hover{ background:#f3b558; }
  .btn-submit:active{ transform:translateY(1px); }

  .login-foot{
    margin-top:22px; padding-top:16px; border-top:1px solid var(--border);
    font-size:11.5px; color:var(--text-faint); text-align:center;
  }
  .shift-dot{
    display:inline-block; width:7px; height:7px; border-radius:50%;
    background:var(--st-terminado); margin-right:6px; box-shadow:0 0 0 3px rgba(79,160,122,.18);
  }

  @media (prefers-reduced-motion: reduce){ *{ transition:none !important; } }
</style>
</head>
<body>

<div class="hazard-bar"></div>

<main class="login-wrap">
  <div class="login-card">

    <div class="brand">
      <div class="brand-mark"></div>
      <div class="brand-text">
        <p class="display">Taller Fortuna</p>
        <span>Panel de gestión</span>
      </div>
    </div>

    <h1>Ingresar</h1>
    <p class="sub">Ingresa con tu usuario y contraseña asignados.</p>

    <%
        String error = (String) request.getAttribute("error");
    %>
    <% if (error != null) { %>
    <div class="alert-error" role="alert">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg>
      <span><%= error %></span>
    </div>
    <% } %>

    <form action="LoginServlet" method="POST" id="loginForm" novalidate>

      <label class="field">
        <span class="field-label">Usuario</span>
        <input type="text" name="usuario" id="usuario" placeholder="ej. drojas" autocomplete="username" required>
      </label>

      <label class="field">
        <span class="field-label">Contraseña</span>
        <div class="password-box">
          <input type="password" name="password" id="password" placeholder="••••••••" autocomplete="current-password" required>
          <button type="button" id="togglePassword" class="toggle-btn" aria-label="Mostrar contraseña">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>
      </label>

      <p class="field-error" id="formError"></p>

      <button type="submit" class="btn-submit">Ingresar</button>
    </form>

    <div class="login-foot">
      <span class="shift-dot"></span>Sistema de gestión — Taller Fortuna
    </div>
  </div>
</main>

<script>
document.addEventListener('DOMContentLoaded', function () {

  var toggleBtn = document.getElementById('togglePassword');
  var passwordInput = document.getElementById('password');

  toggleBtn.addEventListener('click', function () {
    var isHidden = passwordInput.type === 'password';
    passwordInput.type = isHidden ? 'text' : 'password';
    toggleBtn.setAttribute('aria-label', isHidden ? 'Ocultar contraseña' : 'Mostrar contraseña');
  });

  var form = document.getElementById('loginForm');
  var usuarioInput = document.getElementById('usuario');
  var formError = document.getElementById('formError');

  form.addEventListener('submit', function (e) {
    var usuario = usuarioInput.value.trim();
    var password = passwordInput.value.trim();

    usuarioInput.classList.remove('input-error');
    passwordInput.classList.remove('input-error');
    formError.textContent = '';

    if (!usuario || !password) {
      e.preventDefault();
      if (!usuario) usuarioInput.classList.add('input-error');
      if (!password) passwordInput.classList.add('input-error');
      formError.textContent = 'Completa usuario y contraseña para continuar.';
      return;
    }
  });

});
</script>
</body>
</html>