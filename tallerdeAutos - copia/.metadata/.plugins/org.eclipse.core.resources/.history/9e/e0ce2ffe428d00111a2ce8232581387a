<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Registrar Usuario</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 30px; background-color: #f4f7f6; }
        .form-container { background: #ffffff; padding: 25px; border-radius: 8px; max-width: 600px; box-shadow: 0px 0px 10px rgba(0,0,0,0.1); }
        .form-group { margin-bottom: 15px; }
        .form-group label { display: block; margin-bottom: 5px; font-weight: bold; color: #333; }
        .form-group input, .form-group select { width: 100%; padding: 8px; box-sizing: border-box; border: 1px solid #ccc; border-radius: 4px; }
        .btn-submit { background-color: #007bff; color: white; padding: 10px 15px; border: none; border-radius: 4px; cursor: pointer; font-size: 16px; width: 100%; }
        .btn-submit:hover { background-color: #0056b3; }
    </style>
</head>
<body>

<div class="form-container">
    <h2>Registro de Nuevo Usuario</h2>
    
    <!-- El action debe apuntar a la ruta o mapeo de tu Servlet encargado de procesar el registro -->
    <form action="UsuarioServlet?tipo=regist" method="POST" >
    
        <!-- Código -->
        <div class="form-group">
            <label for="txtCod">Código:</label>
            <input type="text" id="txtCod" name="txtCod" required placeholder="Ej: U001">
        </div>

        <!-- Usuario -->
        <div class="form-group">
            <label for="txtUsuario">Usuario:</label>
            <input type="text" id="txtUsuario" name="txtUsuario" required placeholder="Nombre de usuario">
        </div>

        <!-- Password -->
        <div class="form-group">
            <label for="txtPassword">Contraseña:</label>
            <input type="password" id="txtPassword" name="txtPassword" required placeholder="********">
        </div>

        <!-- Rol (id_rol) -->
        <div class="form-group">
            <label for="rol">Rol:</label>
            <select id="rol" name="rol" required>
                <option value="">Seleccione un rol...</option>
                <option value="1">Administrador</option>
                <option value="2">Empleado</option>
                <option value="3">Cliente</option>
            </select>
        </div>

        <!-- Empleado (cboEmpleado) -->
        <div class="form-group">
            <label for="cboEmpleado">¿Es Empleado?</label>
            <select id="cboEmpleado" name="cboEmpleado" required>
                <option value="true">Sí</option>
                <option value="false" selected>No</option>
            </select>
        </div>

        <!-- Apellidos -->
        <div class="form-group">
            <label for="txtApellidos">Apellidos:</label>
            <input type="text" id="txtApellidos" name="txtApellidos" required>
        </div>

        <!-- Nombres -->
        <div class="form-group">
            <label for="txtNombres">Nombres:</label>
            <input type="text" id="txtNombres" name="txtNombres" required>
        </div>

        <!-- Fecha de Nacimiento (txtFechaNac) -->
        <div class="form-group">
            <label for="txtFechaNac">Fecha de Nacimiento:</label>
            <input type="date" id="txtFechaNac" name="txtFechaNac" required>
        </div>

        <!-- Celular -->
        <div class="form-group">
            <label for="txtCelular">Celular:</label>
            <input type="text" id="txtCelular" name="txtCelular" placeholder="Ej: 987654321">
        </div>

        <!-- Correo -->
        <div class="form-group">
            <label for="txtCorreo">Correo Electrónico:</label>
            <input type="email" id="txtCorreo" name="txtCorreo" required placeholder="correo@ejemplo.com">
        </div>

        <!-- Salario -->
        <div class="form-group">
            <label for="txtSalario">Salario:</label>
            <input type="number" step="0.01" id="txtSalario" name="txtSalario" required placeholder="0.00">
        </div>

        <!-- Estado (cboEstado) -->
        <div class="form-group">
            <label for="cboEstado">Estado:</label>
            <select id="cboEstado" name="cboEstado" required>
                <option value="true" selected>Activo</option>
                <option value="false">Inactivo</option>
            </select>
        </div>

        <!-- Botón de envío -->
        <button type="submit" class="btn-submit">Registrar Usuario</button>

    </form>
</div>

</body>
</html>