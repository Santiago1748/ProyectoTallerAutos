	public int regisUsuario(Usuario regUsu) {
	
		int value = 0;
	 
		Connection cn = null;
	
		PreparedStatement psm = null;
	 
	
		try{
		
	
			cn= MySqlConexion.getConexion();
	
			String  sql ="Insert into usuario values (null, ?,?, ?, ?, ?, ?, ?, ?, ?, ?, ?,?,?,?)";
	
			psm = cn.prepareStatement(sql);
		
		psm.setString(1, regUsu.getCodigo());
		psm.setString(2, regUsu.getUsuario());
		psm.setString(3, regUsu.getPassword());
		psm.setObject(4, regUsu.getFec_ultimases());
		psm.setInt(5, regUsu.getId_rol());
		psm.setObject(6, regUsu.getFec_crea());
		psm.setObject(7, regUsu.getFec_modif());
		psm.setBoolean(8, regUsu.isEmpleado());
		psm.setString(9, regUsu.getApellidos());
		psm.setString(10, regUsu.getNombres());
		psm.setObject(11, regUsu.getFecha_nac());
		psm.setString(12, regUsu.getCelular());
		psm.setString(13, regUsu.getCorreo());
		psm.setDouble(14, regUsu.getSalario());
		psm.setBoolean(15, regUsu.isEstado());
	
		value = psm.executeUpdate();
		
		
		
	}catch(Exception e) {
		e.printStackTrace();
		
		
	}finally {
		
		try{
		 if(cn != null)cn.close();
		 if(psm != null)psm.close();
			
		}catch(Exception e) {
			
			e.printStackTrace();
		}
		
	}
		
		
		return value;
	}

	@Override
	public List<Usuario> listarUsuarios() {
		List<Usuario> listaUsuarios = new ArrayList<Usuario>();
		Connection cn = null;
		PreparedStatement psm = null;
		ResultSet rs = null;
		
		try {
			cn = MySqlConexion.getConexion();
			String sql = "select from * usuario";
			psm = cn.prepareCall(sql);
			rs = psm.executeQuery();
			
			while(rs.next()) {
				Usuario usuario = new Usuario();
				usuario.setId(rs.getInt("id"));
				usuario.setCodigo(rs.getString("codigo"));
				usuario.setUsuario(rs.getString("usuario"));
				usuario.setPassword(rs.getString("Password"));
				usuario.setFec_ultimases((LocalDateTime)rs.getObject("ultima_sesion"));
				usuario.setId_rol(rs.getInt("Rol"));
				usuario.setFec_crea((LocalDateTime)rs.getObject("fecha_crea"));
				usuario.setFec_modif((LocalDateTime)rs.getObject("fecha_modif"));
				usuario.setEmpleado(rs.getBoolean("empleado"));
				usuario.setApellidos(rs.getString("apellidos"));
				usuario.setNombres(rs.getString("nombres"));
				usuario.setFecha_nac((LocalDate)rs.getObject("fecha_nac"));
				usuario.setCelular(rs.getString("celular"));
				usuario.setSalario(rs.getDouble("salario"));
				usuario.setEstado(rs.getBoolean("estado"));
				
				
				
				listaUsuarios.add(usuario);
			}
			
		} catch (Exception e) {
			e.printStackTrace();
		} finally {
			try {
				if(rs!=null) rs.close();
				if(psm!=null) psm.close();
				if(cn!=null) cn.close();
			} catch (Exception e) {
				e.printStackTrace();
			}
		}
		return listaUsuarios;
	}

