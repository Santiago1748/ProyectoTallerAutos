    <a class="nav-item" href="#">Repuestos</a>
    <a class="nav-item" href="#">Mecánicos</a>
    <a class="nav-item <%= uri.contains("Usuario") || uri.contains("mantenUsuario") ? "active" : "" %>"
       href="UsuarioServlet?tipo=lis">Usuarios</a>
    <a class="nav-item" href="#">Órdenes de servicio</a>
    <a class="nav-item" href="#">Reportes</a>
  </nav>

  <div class="user-box">
    <div class="u-name">Administrador</div>
    <div class="u-rol">Sesión activa</div>
